# Copy to backend/.env or export before starting the backend.
# Never commit real secrets.

# Database
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/school_management
DATABASE_USERNAME=sms_app
DATABASE_PASSWORD=change-me

# JWT (use a long random string in production, 64+ characters)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-characters-long
JWT_ACCESS_MINUTES=20
JWT_REFRESH_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173

# Files
FILE_STORAGE_DIR=./data/uploads
FILE_MAX_SIZE_MB=10

# Payments (do not store card details; used only to sign/verify gateway payloads)
PAYMENT_SECRET=change-me-payment-hmac-secret
PAYMENT_PROVIDER=mock

# Server
SERVER_PORT=8080
# Use "prod" for pilot/production. Default "dev" enables demo seeders.
SPRING_PROFILES_ACTIVE=dev

# First-time production only (empty users table). Disable after first admin login.
# BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_EMAIL=admin@school.edu
# BOOTSTRAP_ADMIN_USERNAME=superadmin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
# BOOTSTRAP_ADMIN_FULL_NAME=Super Admin
